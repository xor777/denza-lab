<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No permission is requested: the hypothesis is that an ordinary UID needs none, because
         com.byd.avc/.AutoVideoService is exported with no permission and checks no caller. -->

    <queries>
        <package android:name="com.byd.avc" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="AVC stock state probe">

        <!-- BYD's self-start gate drops a broadcast to a UID with no live process, so the host
             starts this invisible Activity by explicit component to wake the process first. -->
        <activity
            android:name=".ProbeWakeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Shell-only seam: DUMP is held by uid 2000 and not grantable to an ordinary app. -->
        <receiver
            android:name=".ProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.denza.avcstock.probe.STATE" />
                <action android:name="dev.denza.avcstock.probe.SET_LIGHT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
