<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.denza.hudaccountowner.probe">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <application android:label="Emulator account owner fixture">
        <service android:name="dev.denza.hud.accountcheck.OwnerService" android:exported="false">
            <intent-filter><action android:name="android.accounts.AccountAuthenticator" /></intent-filter>
            <meta-data android:name="android.accounts.AccountAuthenticator" android:resource="@xml/authenticator" />
        </service>
    </application>
</manifest>
