<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.denza.adasstatus.probe">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <queries><package android:name="com.ts.car.someip.service" /></queries>
    <application android:allowBackup="false" android:debuggable="true" android:label="Статус ADAS">
        <activity android:name=".StatusActivity" android:exported="true" android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <service android:name=".StatusService" android:exported="false" />
    </application>
</manifest>
