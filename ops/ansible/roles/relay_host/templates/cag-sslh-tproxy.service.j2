# Managed by Ansible. CAG-014: the return route for sslh's transparent backends.
[Unit]
Description=CAG relay return route for sslh transparent backends
Before=sslh.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/cag/sslh-tproxy.nft
ExecStart=-/usr/sbin/ip rule del fwmark {{ relay_host_sslh_fwmark }} lookup {{ relay_host_sslh_route_table }}
ExecStart=/usr/sbin/ip rule add fwmark {{ relay_host_sslh_fwmark }} lookup {{ relay_host_sslh_route_table }}
ExecStart=/usr/sbin/ip route replace local 0.0.0.0/0 dev lo table {{ relay_host_sslh_route_table }}
ExecStart=/usr/sbin/sysctl -q -w net.ipv4.conf.all.route_localnet=1
ExecStop=/usr/sbin/sysctl -q -w net.ipv4.conf.all.route_localnet=0
ExecStop=-/usr/sbin/ip route flush table {{ relay_host_sslh_route_table }}
ExecStop=-/usr/sbin/ip rule del fwmark {{ relay_host_sslh_fwmark }} lookup {{ relay_host_sslh_route_table }}
ExecStop=-/usr/sbin/nft delete table ip cag_sslh

[Install]
WantedBy=multi-user.target
