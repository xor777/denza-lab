# Managed by Ansible. CAG-014: sslh-select on the public relay port in
# transparent mode. sslh-ev 2.1.4 never fires the probe timeout, so a client
# that waits for the server's banner would hang; select() caps descriptors at
# 1024. IP_TRANSPARENT needs CAP_NET_RAW; the nft table matches the static
# sslh user, so the packaged DynamicUser is off.
[Unit]
Requires=cag-sslh-tproxy.service
After=cag-sslh-tproxy.service

[Service]
EnvironmentFile=
ExecStart=
ExecStart=/usr/sbin/sslh-select --foreground --config=/etc/cag/sslh.cfg
DynamicUser=no
User=sslh
Group=sslh
CapabilityBoundingSet=
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
Restart=on-failure
RestartSec=5
LimitNOFILE=1024
