<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="dev.denza.apps.permission.CONTROL_SPLIT" />
    <queries>
        <package android:name="dev.denza.apps" />
        <provider android:authorities="dev.denza.apps.split" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_split_screen"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_split_screen"
        android:theme="@style/DenzaSplitTheme">
        <meta-data
            android:name="BYD_SUPPORT_SPLIT_ACTIVITY"
            android:value="1" />

        <activity
            android:name=".SplitPickerActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="standard"
            android:permission="android.permission.DUMP"
            android:resizeableActivity="true"
            android:taskAffinity="dev.denza.split.picker">
            <!--
                SmartMulti persists pane members by package name and restores them through
                PackageManager.getLaunchIntentForPackage(). The exact framework on this car
                resolves CATEGORY_INFO before CATEGORY_LAUNCHER. INFO therefore gives the
                firmware a legal restore component without exposing a second launcher icon or
                making the visible launcher package split-capable.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>

        <!--
            A selected app is launched above this inert base in a separate task. The stable,
            resizeable split-capable base keeps SmartMulti from reclassifying a task from its
            temporary launcher/redirect Activity and also prevents last-Activity cleanup during
            a cold start. The whole task is still disposable, so the native dismiss gesture
            reveals SplitPickerActivity in the independent task below it.
        -->
        <activity
            android:name=".SplitAppHostActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="standard"
            android:permission="android.permission.DUMP"
            android:resizeableActivity="true"
            android:taskAffinity="dev.denza.split"
            android:theme="@style/DenzaSplitAppHostTheme" />

    </application>
</manifest>
