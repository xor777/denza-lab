<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Draws a Luminofor board's fixture with the app's own code, for compare.py. -->
        <activity
            android:name=".debug.LuminoforFixtureActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <!-- Draws the «Экран водителя» panel and its chooser, for a look beside their boards. -->
        <activity
            android:name=".debug.DriverScreenSheetFixtureActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <receiver
            android:name=".SimulcastDebugReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.denza.apps.START_SIMULCAST_TARGET" />
                <action android:name="dev.denza.apps.STOP_SIMULCAST_TARGET" />
                <action android:name="dev.denza.apps.NAVIGATION_PRIMARY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
