<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- Trip panel: standard Android GNSS only (position/altitude/bearing).
         Speed is used internally and never displayed. Missing permission
         degrades gracefully. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Required to attach a Visualizer to the output mix for the trip panel's
         spectrum analyser. The analyser never opens the microphone: the op the
         platform records is RECORD_AUDIO_OUTPUT. See docs/audio-capture-findings.md. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- QUERY_ALL_PACKAGES lets the app picker list every installed app on any car
         and resolve icons/labels for the chosen casting apps; a fixed <queries>
         list cannot represent user-installed launchable apps. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_denza_apps"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_denza_apps"
        android:theme="@style/DenzaAppsTheme">
        <meta-data
            android:name="BYD_SUPPORT_SPLIT_ACTIVITY"
            android:value="1" />
        <service
            android:name=".SimulcastAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/simulcast_a11y_service" />
        </service>
        <service
            android:name=".feature.split.SplitNativePickerAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/split_picker_a11y_service" />
        </service>
        <service
            android:name=".feature.hud.YandexNotificationArtworkListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name=".SimulcastOverlayService"
            android:exported="false" />
        <service
            android:name=".feature.cluster.ClusterSceneService"
            android:exported="false" />
        <!--
            The picker and its inert host are embedded in Denza Apps. The launcher alias below
            only exposes a second icon; it never represents a separately installed package.
            CATEGORY_INFO lets SmartMulti restore the picker component for this split-capable
            package without exposing another always-on launcher entry.
        -->
        <activity
            android:name=".feature.split.SplitPickerActivity"
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="standard"
            android:permission="android.permission.DUMP"
            android:resizeableActivity="true"
            android:taskAffinity="dev.denza.apps.split.picker"
            android:theme="@style/DenzaAppsSplitPickerTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>
        <activity
            android:name=".feature.split.SplitAppHostActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="standard"
            android:permission="android.permission.DUMP"
            android:resizeableActivity="true"
            android:taskAffinity="dev.denza.apps.split.host"
            android:theme="@style/DenzaAppsSplitHostTheme" />
        <activity
            android:name=".feature.split.SplitLauncherEntryActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
        <activity-alias
            android:name=".SplitScreenLauncherAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_split_screen"
            android:label="@string/split_screen_launcher_name"
            android:targetActivity=".feature.split.SplitLauncherEntryActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <provider
            android:name=".feature.split.SplitCommandProvider"
            android:authorities="dev.denza.apps.split"
            android:exported="false" />
        <service
            android:name=".feature.mirrors.SideCameraMonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".feature.weather.WeatherAdapterService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:process=":weather" />
        <receiver
            android:name=".feature.weather.WeatherAdapterReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".SimulcastBootReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="action.byd.dishare.DIALOG_HOME" />
                <action android:name="action.byd.dishare.DIALOG_LAUNCHER" />
                <action android:name="action.byd.dishare.DIALOG_CLOSE" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:taskAffinity="dev.denza.apps.control" />
        <activity
            android:name=".feature.split.SplitPlaceholderActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="dev.denza.apps.split.placeholder" />
        <activity
            android:name=".DenzaLauncherActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
