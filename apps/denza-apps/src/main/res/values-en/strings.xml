    <string name="sheet_cluster_help">The cluster behind the wheel shows one thing at a time: the instruments or any app on the car. A short press on the tile puts it there and takes it back.</string>
    <string name="sheet_cluster_placement">Placement</string>
    <string name="sheet_cluster_wheel_button">★ button on the wheel</string>
    <string name="sheet_cluster_map_card_title">Map in the right window</string>
    <string name="sheet_cluster_map_card_summary">The HUD\'s map replaces the stock one when the cluster\'s right window shows a map</string>
    <string name="sheet_placement_full">Full</string>
    <string name="sheet_placement_left">Left</string>
    <string name="sheet_placement_center">Centre</string>
    <string name="sheet_placement_right">Right</string>
    <string name="sheet_simulcast_help">The chosen apps show on the passenger screen and the rear screen. Launch opens them there at once.</string>
    <string name="sheet_simulcast_support">Simulcast support</string>
    <string name="sheet_mirrors_help">When a turn signal is on, the camera on that side appears on the screen and goes away with the signal. “In the centre” shows both cameras, one above the other.</string>
    <string name="sheet_mirrors_check">Check cameras</string>
    <string name="sheet_mirrors_switch">Mirrors</string>
    <string name="sheet_mirrors_where">Where to show</string>
    <string name="sheet_mirrors_sides">At the sides</string>
    <string name="sheet_mirrors_center">In the centre</string>
    <string name="sheet_mirrors_enhance">Image enhancement</string>
    <string name="sheet_split_help">When on, a split screen icon appears on the home screen. It opens a choice of two apps to place side by side.</string>
    <string name="sheet_split_icon">Icon on the home screen</string>
    <string name="sheet_weather_help">The app fetches the forecast and hands it to the stock weather widget. It draws no weather of its own, and the widget stays stock.</string>
    <string name="sheet_weather_widget_data">Data for the widget</string>
    <string name="sheet_weather_given">Sent to the widget %1$s</string>
    <string name="sheet_speakers_help">The speakers rise when music is playing or a player is open, including apps the car does not count as its own (%1$s). The car lowers them itself. “Raise” brings them up again if the car lowered them while idle.</string>
    <string name="sheet_speakers_auto">Automatic speaker control</string>
    <string name="sheet_speakers_raise">Raise</string>
    <string name="sheet_cloud_help">The car reaches the cloud over Wi-Fi or mobile internet, and the Denza app on your phone works with it as usual: it shows the car\'s status and controls the car. The link comes back if the modem sees a Chinese ICCID, from the original eSIM or from an rSIM. “Keep Wi-Fi on” stops the car turning Wi-Fi off when it goes to sleep, so the link stays while parked.</string>
    <string name="sheet_cloud_keep_link">Keep the cloud link up</string>
    <string name="sheet_cloud_keep_wifi">Keep Wi-Fi on</string>
    <string name="sheet_cloud_keep_wifi_cost">The battery may drain faster while parked</string>
    <string name="sheet_locale_help">The language changes for the whole car, not for the app: the car itself opens the list, which has forty languages, and the chosen one applies at once, with no restart.</string>
    <string name="sheet_service_help">Car readings, the app\'s access to the car, and the stock settings it can reach.</string>

