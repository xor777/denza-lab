<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="dev.denza.apps.permission.CONTROL_SPLIT" />
    <queries>
        <package android:name="dev.denza.apps" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_split_screen"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_split_screen"
        android:theme="@style/DenzaSplitLauncherTheme">
        <activity
            android:name=".SplitLauncherActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@drawable/ic_split_screen"
            android:label="@string/app_name"
            android:noHistory="true"
            android:theme="@style/DenzaSplitLauncherTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
