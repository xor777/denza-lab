#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo "cag-admin must run as root" >&2
  exit 1
fi

case "${1:-}" in
  invite)
    shift
    exec /opt/cag/cag-state create-invite "$@"
    ;;
  status)
    [ "$#" -eq 2 ] || exit 2
    exec /opt/cag/cag-state device-status "$2"
    ;;
  list)
    [ "$#" -eq 1 ] || exit 2
    exec /opt/cag/cag-state list-devices
    ;;
  remove)
    [ "$#" -eq 2 ] || exit 2
    # Ends only this vehicle's tunnel and its computer's sessions.
    exec /opt/cag/cag-state remove-device --disconnect "$2"
    ;;
  rename)
    [ "$#" -eq 3 ] || exit 2
    exec /opt/cag/cag-state rename-device -- "$2" "$3"
    ;;
  doctor)
    [ "$#" -eq 1 ] || exit 2
    exec /opt/cag/cag-state doctor
    ;;
  migrate)
    [ "$#" -eq 1 ] || exit 2
    exec /opt/cag/cag-state migrate
    ;;
  gc)
    [ "$#" -eq 1 ] || exit 2
    # Ends only the sessions of the vehicles whose lease expired.
    exec /opt/cag/cag-state gc --disconnect
    ;;
  *)
    echo "usage: cag-admin invite [--label LABEL] [--ttl SECONDS] | list | status DEVICE_ID | rename DEVICE_ID LABEL | remove DEVICE_ID | doctor | migrate | gc" >&2
    exit 2
    ;;
esac
