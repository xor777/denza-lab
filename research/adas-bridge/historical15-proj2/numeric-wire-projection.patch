+        double length=cumulative[low+1]-cumulative[low];
+        return low+(length>0 ? (metres-cumulative[low])/length : 0);
+    }
+    private static boolean coordinate(double x,double y) {
+        return Double.isFinite(x) && Double.isFinite(y) && x>=-180 && x<=180 && y>=-90 && y<=90;
+    }
+}
