+            double ax=(lon[edge]-rawLon)*scaleX,ay=(lat[edge]-rawLat)*scaleY;
+            double dx=(lon[edge+1]-lon[edge])*scaleX,dy=(lat[edge+1]-lat[edge])*scaleY;
+            double norm=dx*dx+dy*dy;
+            if(norm>0) {
+                double t=Math.max(0,Math.min(1,-(ax*dx+ay*dy)/norm));
+                return Math.hypot(ax+t*dx,ay+t*dy)<distance-1e-7;
+            }
+            edge+=direction;
+        }
+        return false;
+    }
+
+    public boolean validScalar(double scalar) { return Double.isFinite(scalar) && scalar>=0 && scalar<=lon.length-1; }
+    public double totalM() { return cumulative[cumulative.length-1]; }
+    public double metres(double scalar) {
+        return validScalar(scalar) ? RouteConverter.metres(cumulative,scalar) : Double.NaN;
+    }
+    /** A scalar's exact interpolated WGS-84 point, also used for a forward-clamped fallback. */
+    public double[] point(double scalar) {
+        if(!validScalar(scalar))throw new IllegalArgumentException("scalar");
+        int i=Math.min((int)Math.floor(scalar),lon.length-2); double t=scalar-i;
+        return new double[]{lon[i]+t*(lon[i+1]-lon[i]),lat[i]+t*(lat[i+1]-lat[i])};
+    }
+    private double scalarAt(double metres) {
+        if(metres>=totalM())return lon.length-1;
+        int low=0,high=cumulative.length-1;
+        while(low+1<high) { int mid=(low+high)>>>1; if(cumulative[mid]<=metres)low=mid;else high=mid; }
