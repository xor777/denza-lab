+package dev.denza.adaslink;
+
+/** A bounded WGS-84 route projection. Plain Java 8; no SDK, car or clock dependency. */
+public final class RoutePositionProjector {
+    public static final double BACK_M = 20, FORWARD_M = 150, MAX_LATERAL_M = 25;
+    public static final long MAX_RAW_AGE_MS = 1500;
+    private static final double EARTH_M = 6371000;
+    private final double[] lon, lat, cumulative;
+
+    public static final class Result {
+        public final boolean success;
+        public final String reason;
+        /** Final scalar, and raw geometric scalar before age compensation / forward floor. */
+        public final double scalar, projectedScalar, lon, lat, lateralM, advanceM;
+        private Result(boolean success, String reason, double scalar, double projectedScalar,
+                double lon, double lat, double lateralM, double advanceM) {
+            this.success=success; this.reason=reason; this.scalar=scalar; this.projectedScalar=projectedScalar;
+            this.lon=lon; this.lat=lat; this.lateralM=lateralM; this.advanceM=advanceM;
+        }
+        static Result failure(String reason, double lateralM) {
+            return new Result(false,reason,Double.NaN,Double.NaN,Double.NaN,Double.NaN,lateralM,0);
+        }
+    }
+
+    public RoutePositionProjector(YandexRoute route) {
+        lon=route.lon.clone(); lat=route.lat.clone(); cumulative=new double[lon.length];
+        for(int i=0;i<lon.length;i++) {
+            if(!coordinate(lon[i],lat[i]))throw new IllegalArgumentException("route coordinate");
+            if(i>0)cumulative[i]=cumulative[i-1]+Coordinates.distance(lon[i-1],lat[i-1],lon[i],lat[i]);
+        }
+        if(!(totalM()>0))throw new IllegalArgumentException("empty route geometry");
+    }
+
+    /**
+     * Window is centred on the previous chosen scalar (Yandex scalar for the first fix).
+     * A segment is clipped in along-route metres: a perpendicular foot outside the window is
+     * rejected, never pulled onto its artificial endpoint. This avoids accepting a nearby branch
+     * or a fix past +150 m merely because the boundary itself is less than 25 m away.
+     */
+    public Result project(double rawLon,double rawLat,double previousScalar,double speedMps,long rawAgeMs) {
+        if(!coordinate(rawLon,rawLat))return Result.failure("missing_raw",Double.NaN);
+        if(rawAgeMs<0 || rawAgeMs>MAX_RAW_AGE_MS)return Result.failure("stale_raw",Double.NaN);
+        if(!validScalar(previousScalar))return Result.failure("invalid_previous",Double.NaN);
+        double previousM=metres(previousScalar), low=Math.max(0,previousM-BACK_M), high=Math.min(totalM(),previousM+FORWARD_M);
+        double best=Double.POSITIVE_INFINITY, bestScalar=Double.NaN;
+        double scaleX=EARTH_M*Math.cos(Math.toRadians(rawLat))*Math.PI/180;
+        double scaleY=EARTH_M*Math.PI/180;
+        for(int i=0;i<lon.length-1;i++) {
+            double length=cumulative[i+1]-cumulative[i];
+            if(length<=0 || cumulative[i+1]<low || cumulative[i]>high)continue;
+            double ax=(lon[i]-rawLon)*scaleX, ay=(lat[i]-rawLat)*scaleY;
+            double dx=(lon[i+1]-lon[i])*scaleX, dy=(lat[i+1]-lat[i])*scaleY;
+            double norm=dx*dx+dy*dy;
+            if(!(norm>0))continue;
+            double t=Math.max(0,Math.min(1,-(ax*dx+ay*dy)/norm));
+            double at=cumulative[i]+t*length;
+            if(at<low-1e-7 || at>high+1e-7)continue;
+            double distance=Math.hypot(ax+t*dx,ay+t*dy);
+            // An internal vertex is not a new projection target merely because its neighbor's
+            // closer foot was outside the search window. Keep genuine corner nearest vertices.
+            if(t==0 && closerNeighbor(i-1,-1,rawLon,rawLat,scaleX,scaleY,distance))continue;
+            if(t==1 && closerNeighbor(i+1,1,rawLon,rawLat,scaleX,scaleY,distance))continue;
+            // On a crossing, prefer the closest progress to our anchor for equal distances.
+            if(distance<best-1e-7 || (Math.abs(distance-best)<=1e-7
+                    && Math.abs(at-previousM)<Math.abs(metres(bestScalar)-previousM))) {
+                best=distance; bestScalar=i+t;
+            }
+        }
+        if(!Double.isFinite(bestScalar))return Result.failure("outside_window",Double.NaN);
+        if(best>MAX_LATERAL_M)return Result.failure("lateral_distance",best);
+        double advance=Double.isFinite(speedMps) && speedMps>=0 ? speedMps*rawAgeMs/1000.0 : 0;
+        double at=Math.min(totalM(),Math.max(previousM,metres(bestScalar)+advance));
+        if(at>high+1e-7)return Result.failure("outside_window",best);
+        double scalar=scalarAt(at), point[]=point(scalar);
+        return new Result(true,"projected",scalar,bestScalar,point[0],point[1],best,advance);
+    }
+
+    private boolean closerNeighbor(int edge,int direction,double rawLon,double rawLat,
+            double scaleX,double scaleY,double distance) {
