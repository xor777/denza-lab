{
  "schema": "denza-lab.ecu-role-binding-followup.v1",
  "date": "2026-10-21",
  "offlineOnly": true,
  "scope": "Finite semantic follow-up through existing stock OTA named-module registry and CAN identity-record binding; owner corpus only. No repeated fingerprint/DID census or empty-DTC comparison.",
  "operations": {
    "vehicleRequests": 0,
    "adbCalls": 0,
    "networkRequests": 0,
    "cloudRequests": 0,
    "bydLogActions": 0,
    "firmwareExecutions": 0,
    "newExtractions": 0,
    "newDecompiles": 0,
    "productChanges": 0,
    "existingApkResourceMemberReadsForByteComparison": 1
  },
  "result": "no_new_exact_named_child_role_or_physical_brake_binding; explicit_runtime_registry_and_projection_boundary_qualified",
  "newPrecision": [
    {
      "claim": "The stock OTA app has a real named runtime binding registry: getSMMModuleList and NewSmmUpgradeHelper load R.raw.smm_module_config; DiagnoseFactory selects SmmDiagnostic using ecuId.endsWith(ecuIdSuffix).",
      "sourceKeys": [
        "smmConfig",
        "diagnoseFactory",
        "vehicleUtil",
        "newSmmHelper"
      ]
    },
    {
      "claim": "Applying that exact suffix rule to all 225 retained factory candidates finds the explicit FSE to ASSY 5E7/5EF F295/F294 positive control. None of the nine target ECU IDs matches any of the seven registry entries or the Media special case; this source selects generic CanDiagnostic for them.",
      "sourceKeys": [
        "smmConfig",
        "factory",
        "diagnoseFactory",
        "vehicleUtil"
      ],
      "meaning": "The real named registry does not close a target role. This does not establish global absence of definitions."
    },
    {
      "claim": "CanDiagnostic preserves the selected server record, uses its route and second ECU DID, copies nine response bytes to the full code, and writes only five version/code fields to that record. It has no descriptive subrole mapping.",
      "sourceKeys": [
        "canDiagnostic",
        "ecuListModel"
      ],
      "meaning": "Another successful code read confirms the namespace but does not supply the missing INS/FRL/switch name."
    },
    {
      "claim": "EcuListBean has no ecuDescription. EcuVersionInfo has ecuDescription alongside package code and appears in targetPackageInfo. The result writer joins target packages by ecuId while retaining the diagnosed current code separately; it neither compares target and observed full codes there nor carries a description into this result.",
      "sourceKeys": [
        "ecuListModel",
        "ecuVersionModel",
        "versionModel",
        "vehicleUtil"
      ],
      "meaning": "A future retained package description requires exact identity and applicability qualification before resolving an installed subrole."
    },
    {
      "claim": "The saved factory map contains only ten allowed upstream fields plus derived route/evidence. The privacy projector discards all other fields, so absence of description/part/serial in this saved projection cannot prove absence in the original server response.",
      "sourceKeys": [
        "mapProbe",
        "factory"
      ],
      "meaning": "No new cloud request is proposed. A legitimately retained sanitized descriptive record could be relevant; its existence and content remain unknown."
    }
  ],
  "preservedBoundaries": [
    "Nine named subroles remain unbound; exact family, route, child DID and complete code stay together.",
    "Eight prior child software identities remain parent-reported identities behind four logical CAN parents; no new CAN address, physical child separation or independent DTC memory is inferred.",
    "MCU outgoing-ID preservation distinguishes the two numeric routes 7E5/782 at the traced boundary; it supplies no common physical-unit identity.",
    "F394 and F494 collisions at other routes remain relevant; DID alone is not a role key.",
    "The prior 13-binary/23-DID-hit audit was retained, not repeated."
  ],
