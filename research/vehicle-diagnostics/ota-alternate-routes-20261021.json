  "findings": [
    {
      "claim": "In the inspected UpdateOTAModel classes the vehicle plan is requested through loadCheckVehicleVersion; package download receives an already known URL. No separate batch-to-package lookup is exposed there.",
      "scope": "Three model classes and the enumerated URL resources, not every backend API."
    },
    {
      "claim": "GCY/GHY loadEthernetEcuVersionAndCode constructs http://<ecu ip>:<port>/ota/checkVersion; its similar name does not make it a second cloud campaign API."
    },
    {
      "claim": "ProductLineOTA ManufactureConfig has status, delayTime, keyMatch and maxPrepareSeconds; it is not an ECU version matrix. Some route resources have no Java R.string reference in the scoped package; resource presence alone does not establish an active workflow."
    },
    {
      "claim": "COTA groupConfigs is keyed by appInfos with appPkgName/configVer/versionCode/resSeriesCode. Response is ConfigGroup -> AppConfig -> params/resources. Successful native handler saves query metadata and changes config caches.",
      "limit": "params.data is an arbitrary string: the typed schema does not rule out every possible server payload. No ECU strategy consumer was established."
    },
    {
      "claim": "COTA query/pad and its developmenttools variant return application/cluster resource descriptors (resPkgVersionCode, resZipMd5, resZipSize, URL); query/attr returns modelName, carConfiguration, colors, seats and carInfoVersion.",
      "limit": "These are not evidence of the GCY campaign assignment or its expected ECU versions."
    }
  ],
